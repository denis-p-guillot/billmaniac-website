# Default security / SEO-friendly headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Sitemap feeds (also served by functions/_middleware.js)
/sitemap.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: no-store, must-revalidate
  CDN-Cache-Control: no-store

/sitemap-images.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: no-store, must-revalidate
  CDN-Cache-Control: no-store

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

# OG / social image
/pics/og-billmaniac.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=86400, must-revalidate

/pics/hero-track-expenses.jpg
  Cache-Control: public, max-age=86400, must-revalidate

# Android APK direct download (/android page)
/downloads/*
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="billmaniac-pro.apk"
  Cache-Control: public, max-age=3600, must-revalidate

# IndexNow ownership key files
/*.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate
