# Copy to .env and fill in. Never commit .env.

# Required for IndexNow (also stored in config/indexnow.key)
INDEXNOW_KEY=

# Protects POST https://billmaniac.win/api/sitemap-notify
SITEMAP_NOTIFY_SECRET=

# Optional: Bing Webmaster Tools API key (SubmitFeed)
BING_WEBMASTER_API_KEY=

# Optional: custom Google notifier URL; use {sitemap} placeholder if needed
# GOOGLE_SITEMAP_PING_URL=https://example.com/ping?sitemap={sitemap}

# Optional override for <lastmod>
# SITEMAP_LASTMOD=2026-07-12

# Contact form (/api/contact) — set as Pages secrets in Cloudflare dashboard:
# TURNSTILE_SECRET_KEY=   (Cloudflare Turnstile secret key)
# RESEND_API_KEY=         (Resend API key for outbound email)
# Optional Pages vars: TURNSTILE_SITE_KEY, CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL

# Analytics (patch-analytics.py reads these at deploy time)
# GA_MEASUREMENT_ID=G-FY5RTLMWZ9
# CF_WEB_ANALYTICS_TOKEN=   (Cloudflare Web Analytics → billmaniac.win → Manage site)

# AI SEO optimizer (scripts/seo-ai-optimize.mjs)
# OPENAI_API_KEY=sk-...
# OPENAI_SEO_MODEL=gpt-4o-mini

# --- Cloudflare API tokens (see scripts/cloudflare-token-check.mjs) ---
CLOUDFLARE_ACCOUNT_ID=9345927ca3f495f89fdaddea61a5e3f9

# General deploy / DNS / Pages scripts (limited permissions OK)
# CLOUDFLARE_API_TOKEN=

# Dedicated zone token for GSC sitemap + Bot Fight fixes (recommended separate token):
# Permissions on billmaniac.win:
#   Zone → Zone → Read
#   Zone → Zone WAF → Edit
#   Zone → Bot Management → Edit   (optional — disable Bot Fight via API)
#   Zone → Firewall Services → Edit
#   Zone → Cache Purge → Purge     (optional)
# CLOUDFLARE_WAF_TOKEN=
