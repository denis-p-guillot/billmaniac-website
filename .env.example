# Copy to .env and fill in. Never commit .env.

# Required for IndexNow (also stored in config/indexnow.key)
INDEXNOW_KEY=

# Protects POST https://billmaniac.win/api/sitemap-notify
SITEMAP_NOTIFY_SECRET=

# Optional: Bing Webmaster Tools API key (SubmitFeed)
BING_WEBMASTER_API_KEY=

# Optional: custom Google notifier URL; use {sitemap} placeholder if needed
# GOOGLE_SITEMAP_PING_URL=https://example.com/ping?sitemap={sitemap}

# Optional override for <lastmod>
# SITEMAP_LASTMOD=2026-07-12

CLOUDFLARE_ACCOUNT_ID=9345927ca3f495f89fdaddea61a5e3f9
